rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Company job photos — only authenticated company members can read/write
    match /companies/{companyId}/jobs/{jobId}/photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
